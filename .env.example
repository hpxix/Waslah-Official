# Copy this file to .env for a local frontend outside Docker.
# Values marked FILL_ME are required for the related live integration.

# Application and Directus authentication
VITE_APP_URL=http://localhost:3001
VITE_DIRECTUS_URL=http://localhost:8055
VITE_DIRECTUS_TOKEN=
VITE_DIRECTUS_LEAD_AGENT_PATH=/lead-agent
VITE_ENABLE_PRODUCT_TOUR=true
VITE_WELCOME_CREDIT_SAR=30
# Social OAuth secrets belong only in the Directus .env.docker file.
# The browser callback route is: http://localhost:3001/auth/social

# Optional Directus AI flows
VITE_DIRECTUS_AI_FLOW_PATH=/flows/trigger/waslah-ai
VITE_DIRECTUS_APIFY_FLOW_PATH=/flows/trigger/apify-leads
VITE_DIRECTUS_RESEARCH_FLOW_PATH=/flows/trigger/perplexity-research
VITE_DIRECTUS_PROPOSAL_FLOW_PATH=/flows/trigger/openai-proposal
VITE_DIRECTUS_EMAIL_FLOW_PATH=/flows/trigger/email-campaign

# Live provider keys are consumed by Directus/n8n, never by browser code.
OPENAI_API_KEY=FILL_ME_OPENAI_API_KEY
APIFY_TOKEN=FILL_ME_APIFY_TOKEN
APIFY_ACTOR_ID=compass/crawler-google-places
PERPLEXITY_API_KEY=FILL_ME_PERPLEXITY_API_KEY
OPENROUTER_API_KEY=FILL_ME_OPENROUTER_API_KEY
OPENROUTER_RESEARCH_MODEL=perplexity/sonar-deep-research
VAPI_API_KEY=FILL_ME_VAPI_API_KEY
VAPI_ASSISTANT_ID=FILL_ME_VAPI_ASSISTANT_ID
VAPI_PHONE_NUMBER_ID=FILL_ME_VAPI_PHONE_NUMBER_ID
TWILIO_ACCOUNT_SID=FILL_ME_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=FILL_ME_TWILIO_AUTH_TOKEN
TWILIO_VERIFY_SERVICE_SID=FILL_ME_TWILIO_VERIFY_SERVICE_SID
