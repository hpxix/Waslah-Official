FRONTEND_PORT=3001
DIRECTUS_PORT=8055
POSTGRES_PORT=5432
REDIS_PORT=6379
N8N_PORT=5678

POSTGRES_DB=waslah
POSTGRES_USER=waslah
POSTGRES_PASSWORD=waslah_dev_password

DIRECTUS_PUBLIC_URL=http://localhost:8055
DIRECTUS_CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001
DIRECTUS_ADMIN_EMAIL=FILL_ME_ADMIN_EMAIL
DIRECTUS_ADMIN_PASSWORD=FILL_ME_STRONG_ADMIN_PASSWORD
KEY=replace-with-32-plus-random-characters
SECRET=replace-with-32-plus-random-characters
WASLAH_CUSTOMER_ROLE_ID=8c62f1c4-258c-4d77-92f2-33f87db31765

# Social account creation. Add enabled provider names after filling their keys,
# for example: AUTH_PROVIDERS=google,microsoft
AUTH_PROVIDERS=
AUTH_GOOGLE_DRIVER=openid
AUTH_GOOGLE_MODE=session
AUTH_GOOGLE_CLIENT_ID=FILL_ME_GOOGLE_CLIENT_ID
AUTH_GOOGLE_CLIENT_SECRET=FILL_ME_GOOGLE_CLIENT_SECRET
AUTH_GOOGLE_ISSUER_URL=https://accounts.google.com/.well-known/openid-configuration
AUTH_GOOGLE_ISSUER_DISCOVERY_MUST_SUCCEED=false
AUTH_GOOGLE_IDENTIFIER_KEY=email
AUTH_GOOGLE_SYNC_USER_INFO=true
AUTH_GOOGLE_LABEL=Google
AUTH_GOOGLE_ALLOW_PUBLIC_REGISTRATION=true
AUTH_GOOGLE_DEFAULT_ROLE_ID=8c62f1c4-258c-4d77-92f2-33f87db31765
AUTH_GOOGLE_REDIRECT_ALLOW_LIST=http://localhost:3001/auth/social

AUTH_MICROSOFT_DRIVER=openid
AUTH_MICROSOFT_MODE=session
AUTH_MICROSOFT_CLIENT_ID=FILL_ME_MICROSOFT_CLIENT_ID
AUTH_MICROSOFT_CLIENT_SECRET=FILL_ME_MICROSOFT_CLIENT_SECRET
AUTH_MICROSOFT_ISSUER_URL=https://login.microsoftonline.com/common/v2.0/.well-known/openid-configuration
AUTH_MICROSOFT_IDENTIFIER_KEY=preferred_username
AUTH_MICROSOFT_EMAIL_KEY=email
AUTH_MICROSOFT_SYNC_USER_INFO=true
AUTH_MICROSOFT_LABEL=Microsoft
AUTH_MICROSOFT_ALLOW_PUBLIC_REGISTRATION=true
AUTH_MICROSOFT_DEFAULT_ROLE_ID=8c62f1c4-258c-4d77-92f2-33f87db31765
AUTH_MICROSOFT_REDIRECT_ALLOW_LIST=http://localhost:3001/auth/social

AUTH_APPLE_DRIVER=openid
AUTH_APPLE_MODE=session
AUTH_APPLE_CLIENT_ID=FILL_ME_APPLE_SERVICE_ID
AUTH_APPLE_CLIENT_SECRET=FILL_ME_APPLE_GENERATED_CLIENT_SECRET
AUTH_APPLE_ISSUER_URL=https://appleid.apple.com/.well-known/openid-configuration
AUTH_APPLE_SCOPE=name email
AUTH_APPLE_IDENTIFIER_KEY=email
AUTH_APPLE_LABEL=Apple
AUTH_APPLE_PARAMS={"response_mode":"form_post"}
AUTH_APPLE_ALLOW_PUBLIC_REGISTRATION=true
AUTH_APPLE_DEFAULT_ROLE_ID=8c62f1c4-258c-4d77-92f2-33f87db31765
AUTH_APPLE_REDIRECT_ALLOW_LIST=http://localhost:3000/auth/social

# Local session cookies. Use secure=true and an appropriate cookie domain in production.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Public URLs
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=replace-with-32-plus-random-characters
WASLAH_DIRECTUS_INTERNAL_URL=http://directus:8055
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Waslah orchestration and webhook authentication
N8N_LEAD_AGENT_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=replace-with-a-long-random-secret
VAPI_WEBHOOK_SECRET=replace-with-a-different-long-random-secret

# Phone verification: "console" for local development or "twilio" for live SMS
SMS_PROVIDER=console
SMS_DEV_EXPOSE_CODE=true
OTP_HASH_SECRET=replace-with-a-long-random-secret
TWILIO_ACCOUNT_SID=FILL_ME_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=FILL_ME_TWILIO_AUTH_TOKEN
TWILIO_VERIFY_SERVICE_SID=FILL_ME_TWILIO_VERIFY_SERVICE_SID

# Vapi outbound calling
VAPI_API_KEY=FILL_ME_VAPI_API_KEY
VAPI_ASSISTANT_ID=FILL_ME_VAPI_ASSISTANT_ID
VAPI_PHONE_NUMBER_ID=FILL_ME_VAPI_PHONE_NUMBER_ID

OPENAI_API_KEY=FILL_ME_OPENAI_API_KEY
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_CONTENT_MODEL=gpt-5.6-terra

# Social command center. Generate a dedicated random value (32+ characters)
# before production; SECRET is used only as a local fallback.
SOCIAL_TOKEN_ENCRYPTION_KEY=FILL_ME_32_PLUS_RANDOM_CHARACTERS
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

# Publishing, unified inbox, and AI observability services.
# Point these at your hosted or self-hosted instances; no secret reaches the browser.
POSTIZ_BASE_URL=https://api.postiz.com/public/v1
POSTIZ_API_KEY=
# Optional legacy single-workspace routing; required when using the server key.
POSTIZ_ORGANIZATION_ID=
CHATWOOT_BASE_URL=
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_ORGANIZATION_ID=
# Reserved for future telemetry instrumentation; not active in this release.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# B2C Haraj marketplace acquisition (keep the live token in .env.haraj)
HARAJ_GRAPHQL_BASE_URL=FILL_ME_HARAJ_GRAPHQL_BASE_URL
HARAJ_POSTS_URL=FILL_ME_HARAJ_POSTS_URL
HARAJ_POST_CONTACT_URL=FILL_ME_HARAJ_POST_CONTACT_URL
HARAJ_TRENDING_KEYWORDS_URL=FILL_ME_HARAJ_TRENDING_KEYWORDS_URL
HARAJ_BEARER_TOKEN=FILL_ME_HARAJ_BEARER_TOKEN
HARAJ_CLIENT_ID=FILL_ME_HARAJ_CLIENT_ID
HARAJ_CLIENT_VERSION=FILL_ME_HARAJ_CLIENT_VERSION
HARAJ_DEFAULT_PAGE=0
HARAJ_DEFAULT_LIMIT=50
HARAJ_MAX_PAGES_PER_STRATEGY=3
HARAJ_REQUEST_TIMEOUT_MS=20000
HARAJ_REQUEST_RETRIES=3
HARAJ_MAX_CONCURRENCY=3
LEAD_SOURCE_INTERNAL=haraj
B2C_MAX_STRATEGIES=6
B2C_MINIMUM_LEAD_SCORE=65
B2C_MINIMUM_IDENTITY_CONFIDENCE=60
B2C_MINIMUM_PURCHASE_PROPENSITY=55
B2C_LLM_QUALIFICATION_ENABLED=true
APIFY_TOKEN=FILL_ME_APIFY_TOKEN
APIFY_ACTOR_ID=compass/crawler-google-places
PERPLEXITY_API_KEY=FILL_ME_PERPLEXITY_API_KEY
PERPLEXITY_MODEL=sonar-pro
OPENROUTER_API_KEY=FILL_ME_OPENROUTER_API_KEY
OPENROUTER_RESEARCH_MODEL=perplexity/sonar-deep-research

MAIL_FROM=FILL_ME_FROM_EMAIL
SMTP_HOST=FILL_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USER=FILL_ME_SMTP_USER
SMTP_PASSWORD=FILL_ME_SMTP_PASSWORD
